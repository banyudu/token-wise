{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-wise",
  "version": "0.1.1",
  "identifier": "com.banyudu.token-wise",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5613",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Token Wise",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: tauri:; connect-src ipc: tauri:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0",
      "files": {
        "embedded.provisionprofile": "embedded.provisionprofile"
      }
    }
  }
}
