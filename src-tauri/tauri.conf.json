{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-wise",
  "version": "0.1.9",
  "identifier": "com.banyudu.token-wise",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5613",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Token Wise",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: tauri:; connect-src ipc: tauri:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "Developer ID Application: Yudu Ban (RYLS8UDY5D)",
      "entitlements": "Entitlements.dev.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzRDlDQzk3ODlGNzZFOTUKUldTVmJ2ZUpsOHpaNCt5Zzc2NDFQSkQyR0MzRTNlOEd2WTF4RXNOTWRtczMvejk5UTB1RjdjREUK",
      "endpoints": [
        "https://assets.banyudu.com/token-wise/latest.json"
      ]
    }
  }
}